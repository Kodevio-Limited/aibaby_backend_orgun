# Django's connection to that same Postgres container
DATABASE_URL=postgres://aibaby:changeme_dev_password@db:5432/aibaby_db

REDIS_URL=redis://redis:6379/0
REPLICATE_API_TOKEN=
SENTRY_DSN=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
