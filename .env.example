SECRET_KEY=change-me-to-a-random-secret

# Postgres container config (used by the db service itself)
POSTGRES_USER=aibaby
POSTGRES_PASSWORD=changeme_dev_password
POSTGRES_DB=aibaby_db

# Django's connection to the Postgres container
# IMPORTANT: Use "db" (service name), not "localhost" when running inside Docker
DATABASE_URL=postgres://aibaby:changeme_dev_password@db:5432/aibaby_db

# Redis connection
# IMPORTANT: Use "redis" (service name), not "localhost" when running inside Docker
REDIS_URL=redis://redis:6379/0
REPLICATE_API_TOKEN=
REPLICATE_BABY_MODEL=tencentarc/photomaker
REPLICATE_BABY_VERSION=ddfc2b08d209f9fa8c1eca692712918bd449f695dabb4a958da31802a9570fe4

# Public origin used by Celery tasks when building absolute image URLs for providers.
# In production this MUST be the public origin (e.g. https://aibaby.kodevio.com)
# so Replicate can download the parent photos.
BASE_URL=http://localhost:8000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
SENTRY_DSN=

# --- Production-only settings (config.settings.production) ---
# ALLOWED_HOSTS / CORS_ALLOWED_ORIGINS / CSRF_TRUSTED_ORIGINS are REQUIRED when
# DJANGO_SETTINGS_MODULE=config.settings.production. CSRF_TRUSTED_ORIGINS must
# include the public origin, otherwise admin/API POST requests fail with 403.
# Comma-separated lists (no spaces).
ALLOWED_HOSTS=localhost,127.0.0.1,aibaby.kodevio.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://orkunadmin.kodevio.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,https://orkunadmin.kodevio.com
